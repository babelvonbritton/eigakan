---
/** Connection status line, partner-buffering indicator, and invite button. */
---

<div class="controls-bar">
  <span class="status-text"><span class="status-dot" id="status-dot"></span><span id="status-text">Connecting…</span></span>
  <span class="status-text" id="partner-buffering" style="display:none"><svg class="icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 2h12M6 22h12M8 2v6l4 4 4-4V2M8 22v-6l4-4 4 4v6"/></svg> Partner is buffering — room is holding…</span>
  <span class="room-people" id="room-people" style="display:none"></span>
  <div class="spacer" style="flex:1"></div>
  <button class="btn btn-ghost" id="copy-invite" type="button">Copy invite link</button>
  <button class="btn btn-ghost" id="leave-room" type="button">Leave room</button>
</div>
