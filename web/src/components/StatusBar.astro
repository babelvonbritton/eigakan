---
/** Connection status line, partner-buffering indicator, and invite button. */
---

<div class="controls-bar">
  <span class="status-text"><span class="status-dot" id="status-dot"></span><span id="status-text">Connecting…</span></span>
  <span class="status-text" id="partner-buffering" style="display:none">⏳ Partner is buffering — room is holding…</span>
  <div class="spacer" style="flex:1"></div>
  <button class="btn btn-ghost" id="copy-invite" type="button">Copy invite link</button>
</div>
