---
/** Minimal in-room chat. */
---

<div class="panel chat-panel">
  <h2>Chat</h2>
  <div class="chat-log" id="chat-log"><p>Say hi when your partner lands.</p></div>
  <form class="row" id="chat-form" style="margin-top:0.7rem">
    <input class="field" id="chat-input" placeholder="Message…" autocomplete="off" maxlength="500" />
    <button class="btn btn-ghost" type="submit">Send</button>
  </form>
</div>
