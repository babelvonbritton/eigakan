---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBar from '../components/StatusBar.astro';
import SourcePanel from '../components/SourcePanel.astro';
import ChatPanel from '../components/ChatPanel.astro';

const roomParam = Astro.url.searchParams.get('room') ?? '';
---

<BaseLayout title={`Eigakan Room ${roomParam}`} roomCode={roomParam || undefined}>
  <main class="theater">
    <div class="panel" id="name-gate" style="display:none; margin-bottom:1rem">
      <h2>Before you enter the room</h2>
      <p class="hint">Pick a display name — the label your partner will see next to your messages. Not a login, just a name tag for this room.</p>
      <form class="row" id="name-form" style="margin-top:0.7rem">
        <input class="field" id="name-input" maxlength="24" placeholder="Your display name" autocomplete="off" />
        <button class="btn btn-brand" type="submit">Enter room</button>
      </form>
    </div>
    <div class="stage" id="stage">
      <div class="placeholder" id="placeholder">
        <div class="wordmark" style="font-size:2.4rem">EIGAKAN</div>
        <p>
          Waiting for a video.<br />
          Paste a YouTube or MP4 link below — or both pick the same local file.
        </p>
      </div>
      <video id="html5-player" controls playsinline style="display:none"></video>
      <div id="yt-wrap" style="display:none; position:absolute; inset:0">
        <div id="yt-player"></div>
      </div>
      <span class="badge" id="source-badge" style="display:none"></span>
    </div>

    <StatusBar />
    <SourcePanel />
    <ChatPanel />
  </main>

  <script>
    import { normalizeRoomCode, parseVideoSource, type VideoSource } from '@eigakan/sync-core';
    import { Html5PlayerAdapter, YouTubePlayerAdapter, type LocalControlAction, type PlayerAdapter } from '../lib/players';
    import { RoomClient } from '../lib/room-client';

    const params = new URLSearchParams(window.location.search);
    const code = normalizeRoomCode(params.get('room') ?? '');

    const statusDot = document.getElementById('status-dot');
    const statusText = document.getElementById('status-text');
    const partnerBuffering = document.getElementById('partner-buffering');
    const placeholder = document.getElementById('placeholder');
    const badge = document.getElementById('source-badge');
    const videoEl = document.getElementById('html5-player') as HTMLVideoElement;
    const ytWrap = document.getElementById('yt-wrap');
    const sourceError = document.getElementById('source-error');
    const chatLog = document.getElementById('chat-log');
    const nameGate = document.getElementById('name-gate');
    const nameForm = document.getElementById('name-form') as HTMLFormElement | null;
    const nameInput = document.getElementById('name-input') as HTMLInputElement | null;
    const roomNames = document.getElementById('room-names');
    const isHost = params.get('host') === '1';

    function setStatus(text: string, on: boolean) {
      if (statusText) statusText.textContent = text;
      statusDot?.classList.toggle('on', on);
    }

    if (!code) {
      setStatus('Invalid room code — go back and create or join a room.', false);
    } else {
      const html5 = new Html5PlayerAdapter(videoEl, 'mp4');
      const youtube = new YouTubePlayerAdapter('yt-player');

      const showHtml5 = () => {
        videoEl.style.display = 'block';
        if (ytWrap) ytWrap.style.display = 'none';
        if (placeholder) placeholder.style.display = 'none';
      };
      const showYouTube = () => {
        videoEl.style.display = 'none';
        if (ytWrap) ytWrap.style.display = 'block';
        if (placeholder) placeholder.style.display = 'none';
      };

      /**
       * Facade adapter: the sync engine talks to one player; this routes to
       * whichever concrete adapter owns the current source.
       */
      class FacadePlayer implements PlayerAdapter {
        active: PlayerAdapter = html5;
        get kind() {
          return this.active.kind;
        }
        async load(source: VideoSource): Promise<void> {
          if (source.kind === 'youtube') {
            this.active = youtube;
            showYouTube();
          } else {
            this.active = html5;
            showHtml5();
          }
          await this.active.load(source);
        }
        play() { this.active.play(); }
        pause() { this.active.pause(); }
        seekTo(s: number) { this.active.seekTo(s); }
        setRate(r: number) { this.active.setRate(r); }
        getTime() { return this.active.getTime(); }
        getRate() { return this.active.getRate(); }
        isPlaying() { return this.active.isPlaying(); }
        isBuffering() { return this.active.isBuffering(); }
        onLocalControl(handler: (a: LocalControlAction) => void) {
          const offA = html5.onLocalControl(handler);
          const offB = youtube.onLocalControl(handler);
          return () => { offA(); offB(); };
        }
        destroy() { html5.destroy(); youtube.destroy(); }
      }

      const facade = new FacadePlayer();
      const configuredApiBase = (import.meta.env.PUBLIC_ROOM_API_URL as string | undefined)?.replace(/\/+$/, '');
      const apiBase = configuredApiBase || (import.meta.env.DEV ? 'http://localhost:8787' : '');
      const rawBase = import.meta.env.BASE_URL as string;
      const basePath = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

      let client: RoomClient | undefined;
      const startRoom = (displayName: string) => {
      if (!apiBase) {
        setStatus('Room server is not configured. Set PUBLIC_ROOM_API_URL for this deployment and rebuild the site.', false);
        return;
      }
      client = new RoomClient(apiBase, code, facade, {
        onStatus(status) {
          if (status === 'waiting') setStatus(`Room ${code} — waiting for your partner. Share the invite link.`, true);
          else if (status === 'paired') setStatus('Partner connected — you are in sync.', true);
          else if (status === 'full') setStatus('This room is already full (2 viewers).', false);
          else if (status === 'ended') {
            setStatus('This room has ended. Taking you home…', false);
            window.setTimeout(() => { window.location.href = basePath; }, 2000);
          }
          else if (status === 'connecting') setStatus('Connecting…', false);
          else setStatus('Disconnected.', false);
        },
        onError(message) {
          setStatus(message, false);
        },
        onSessionReady() {
          void refreshLibrary();
        },
        onPresence(names) {
          if (roomNames) roomNames.textContent = names.length ? `In this room: ${names.join(' + ')}` : '';
        },
        onChat(text, mine, name) {
          const p = document.createElement('p');
          if (mine) p.className = 'me';
          p.textContent = `${name}: ${text}`;
          chatLog?.appendChild(p);
          if (chatLog) chatLog.scrollTop = chatLog.scrollHeight;
        },
        onPartnerBuffering(buffering) {
          if (partnerBuffering) partnerBuffering.style.display = buffering ? 'inline-flex' : 'none';
        },
        onSourceLoaded(source) {
          if (badge) {
            badge.style.display = 'inline-block';
            badge.textContent =
              source.kind === 'youtube'
                ? 'YOUTUBE'
                : source.kind === 'mp4'
                  ? 'MP4'
                  : source.kind === 'r2-file'
                    ? 'R2 • UPLOADED'
                    : source.kind === 'hls'
                      ? 'HLS • ADAPTIVE'
                      : 'LOCAL FILE';
          }
          if (source.kind === 'local-file') {
            // Show the video element so this viewer can pick their copy.
            facade.active = html5;
            showHtml5();
            if (sourceError) sourceError.textContent = 'Your partner loaded a local file — pick the same file with “Use a local file…” to watch your copy in sync.';
          }
        },
      }, { displayName, isHost });
      client.connect();
      };

      // ——— display-name gate: reuse a remembered name, else ask first ———
      const rememberedName =
        sessionStorage.getItem('eigakan-display-name') || localStorage.getItem('eigakan-display-name');
      if (rememberedName) {
        startRoom(rememberedName);
      } else if (nameGate && nameForm && nameInput) {
        nameGate.style.display = 'block';
        nameForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const chosen = nameInput.value.replace(/\s+/g, ' ').trim().slice(0, 24) || 'Guest';
          localStorage.setItem('eigakan-display-name', chosen);
          sessionStorage.setItem('eigakan-display-name', chosen);
          nameGate.style.display = 'none';
          startRoom(chosen);
        });
      } else {
        startRoom('Guest');
      }

      // ——— source loading UI ———
      const sourceForm = document.getElementById('source-form') as HTMLFormElement;
      const sourceInput = document.getElementById('source-input') as HTMLInputElement;
      sourceForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const source = parseVideoSource(sourceInput.value);
        if (!source) {
          if (sourceError) sourceError.textContent = 'That link is not a YouTube or MP4 source I can play.';
          return;
        }
        if (sourceError) sourceError.textContent = '';
        client?.loadSource(source);
      });

      // ——— private-R2 HLS: mint a signed playlist URL, then load it for both ———
      const hlsForm = document.getElementById('hls-form') as HTMLFormElement;
      const hlsPrefixInput = document.getElementById('hls-prefix-input') as HTMLInputElement;
      hlsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        try {
          if (sourceError) sourceError.textContent = '';
          if (!client) throw new Error('Enter the room first — pick your display name above.');
          const url = await client.fetchHlsUrl(hlsPrefixInput.value);
          client.loadSource({ kind: 'hls', ref: url });
        } catch (err) {
          if (sourceError) sourceError.textContent = err instanceof Error ? err.message : 'Could not load that R2 HLS folder.';
        }
      });

      const fileInput = document.getElementById('file-input') as HTMLInputElement;
      document.getElementById('pick-file')?.addEventListener('click', () => fileInput.click());
      fileInput.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (!file) return;
        facade.active = html5;
        showHtml5();
        client?.loadLocalFile(file, html5);
      });

      // ——— reusable uploaded-movie library (spans earlier rooms) ———
      const libraryList = document.getElementById('library-list');
      const libraryStatus = document.getElementById('library-status');
      const refreshLibraryButton = document.getElementById('refresh-library') as HTMLButtonElement | null;
      let libraryLoading = false;

      const formatMovieSize = (size: number) => {
        const units = ['B', 'KB', 'MB', 'GB', 'TB'];
        let value = size;
        let unit = 0;
        while (value >= 1024 && unit < units.length - 1) {
          value /= 1024;
          unit++;
        }
        return `${value >= 10 || unit === 0 ? value.toFixed(0) : value.toFixed(1)} ${units[unit]}`;
      };
      const formatMovieDate = (iso: string) => {
        const date = new Date(iso);
        return Number.isNaN(date.getTime())
          ? ''
          : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(date);
      };

      const refreshLibrary = async () => {
        if (!client || !libraryList || !libraryStatus || libraryLoading) return;
        libraryLoading = true;
        if (refreshLibraryButton) refreshLibraryButton.disabled = true;
        libraryStatus.textContent = 'Loading uploaded movies…';
        try {
          const movies = await client.listUploadedMovies();
          libraryList.replaceChildren();
          if (!movies.length) {
            libraryStatus.textContent = 'No uploaded movies yet. Upload one here and it will remain available to later rooms.';
            return;
          }
          libraryStatus.textContent =
            `${movies.length} uploaded ${movies.length === 1 ? 'movie is' : 'movies are'} available. ` +
            'They remain reusable until the bucket lifecycle removes them.';
          for (const movie of movies) {
            const item = document.createElement('div');
            item.className = 'library-item';

            const info = document.createElement('div');
            info.className = 'library-info';
            const title = document.createElement('div');
            title.className = 'library-title';
            title.textContent = movie.title;
            const meta = document.createElement('div');
            meta.className = 'library-meta';
            const uploaded = formatMovieDate(movie.uploadedAt);
            meta.textContent = uploaded
              ? `${formatMovieSize(movie.size)} · Uploaded ${uploaded}`
              : formatMovieSize(movie.size);
            info.append(title, meta);

            const actions = document.createElement('div');
            actions.className = 'library-actions';
            const playButton = document.createElement('button');
            playButton.type = 'button';
            playButton.className = 'btn btn-brand';
            playButton.textContent = 'Play for both';
            playButton.addEventListener('click', () => {
              if (sourceError) sourceError.textContent = '';
              client?.loadSource({ kind: 'r2-file', ref: movie.key, title: movie.title });
            });

            const deleteButton = document.createElement('button');
            deleteButton.type = 'button';
            deleteButton.className = 'btn btn-ghost library-delete';
            deleteButton.textContent = 'Delete';
            deleteButton.addEventListener('click', async () => {
              if (!client) return;
              if (!window.confirm(`Delete “${movie.title}” permanently for everyone? This cannot be undone.`)) return;
              playButton.disabled = true;
              deleteButton.disabled = true;
              try {
                await client.deleteUploadedMovie(movie.key);
                await refreshLibrary();
              } catch (err) {
                if (sourceError) {
                  sourceError.textContent = err instanceof Error ? err.message : 'Could not delete that movie.';
                }
                playButton.disabled = false;
                deleteButton.disabled = false;
              }
            });

            actions.append(playButton, deleteButton);
            item.append(info, actions);
            libraryList.append(item);
          }
        } catch (err) {
          libraryList.replaceChildren();
          libraryStatus.textContent = err instanceof Error ? err.message : 'Could not load the uploads library.';
        } finally {
          libraryLoading = false;
          if (refreshLibraryButton) refreshLibraryButton.disabled = false;
        }
      };
      refreshLibraryButton?.addEventListener('click', () => void refreshLibrary());

      // ——— in-site movie upload (browser → R2, worker brokers) ———
      const uploadInput = document.getElementById('upload-input') as HTMLInputElement | null;
      const uploadBox = document.getElementById('upload-box');
      const uploadLabel = document.getElementById('upload-label');
      const uploadFill = document.getElementById('upload-fill') as HTMLElement | null;
      let uploadAbort: AbortController | null = null;
      document.getElementById('pick-upload')?.addEventListener('click', () => uploadInput?.click());
      document.getElementById('upload-cancel')?.addEventListener('click', () => uploadAbort?.abort());
      uploadInput?.addEventListener('change', async () => {
        const file = uploadInput.files?.[0];
        uploadInput.value = '';
        if (!file) return;
        if (!client) {
          if (sourceError) sourceError.textContent = 'Enter the room first — pick your display name above.';
          return;
        }
        if (sourceError) sourceError.textContent = '';
        uploadAbort = new AbortController();
        uploadBox?.classList.remove('hidden');
        if (uploadFill) uploadFill.style.width = '0%';
        if (uploadLabel) uploadLabel.textContent = `Uploading ${file.name} — 0%`;
        try {
          const key = await client.uploadMovie(
            file,
            (fraction) => {
              const pct = Math.floor(fraction * 100);
              if (uploadFill) uploadFill.style.width = `${pct}%`;
              if (uploadLabel) uploadLabel.textContent = `Uploading ${file.name} — ${pct}%`;
            },
            uploadAbort.signal,
          );
          if (uploadLabel) uploadLabel.textContent = 'Uploaded — loading it for both of you…';
          client.loadSource({ kind: 'r2-file', ref: key, title: file.name });
          void refreshLibrary();
          window.setTimeout(() => uploadBox?.classList.add('hidden'), 2500);
        } catch (err) {
          uploadBox?.classList.add('hidden');
          if (sourceError) {
            sourceError.textContent =
              err instanceof DOMException && err.name === 'AbortError'
                ? 'Upload cancelled.'
                : err instanceof Error
                  ? err.message
                  : 'Upload failed.';
          }
        } finally {
          uploadAbort = null;
        }
      });

      // ——— invite + chat UI ———
      document.getElementById('copy-invite')?.addEventListener('click', async () => {
        const link = `${window.location.origin}${basePath}watch/?room=${code}`;
        try {
          await navigator.clipboard.writeText(link);
          setStatus('Invite link copied — send it to your partner.', true);
        } catch {
          window.prompt('Copy your invite link:', link);
        }
      });

      const leaveBtn = document.getElementById('leave-room');
      if (leaveBtn) {
        leaveBtn.textContent = isHost ? 'End room' : 'Leave room';
        leaveBtn.addEventListener('click', () => {
          if (!client) { window.location.href = basePath; return; }
          if (isHost) {
            if (!window.confirm('End this room for both of you? The room code and invite link will stop working.')) return;
            client.endRoom();
            // The server answers with room-ended (handled in onStatus);
            // navigate anyway as a belt-and-braces fallback.
            window.setTimeout(() => { window.location.href = basePath; }, 1500);
          } else {
            client.close();
            window.location.href = basePath;
          }
        });
      }

      const chatForm = document.getElementById('chat-form') as HTMLFormElement;
      const chatInput = document.getElementById('chat-input') as HTMLInputElement;
      chatForm.addEventListener('submit', (e) => {
        e.preventDefault();
        client?.sendChat(chatInput.value);
        chatInput.value = '';
      });
    }
  </script>
</BaseLayout>
