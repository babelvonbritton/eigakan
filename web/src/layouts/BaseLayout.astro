---
const base = import.meta.env.BASE_URL;
import '@fontsource/bebas-neue';
import '../styles/global.css';

interface Props {
  title?: string;
  roomCode?: string;
}

const { title = 'Eigakan — Watch Together, For Two', roomCode } = Astro.props;
// Base-aware asset prefix for the PWA + icon links (BASE_URL has no trailing
// slash when a base is set).
const assetBase = base.endsWith('/') ? base : `${base}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Eigakan syncs a YouTube video, an MP4 or a local file between exactly two viewers — play, pause and seek together, in real time." />
    <meta name="theme-color" content="#050403" />
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${assetBase}icons/apple-touch-icon.png`} />
    <link rel="manifest" href={`${assetBase}manifest.webmanifest`} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Eigakan" />
    <title>{title}</title>
  </head>
  <body>
    <header class="nav" id="top-nav">
      <a class="wordmark" href={base}>EIGAKAN</a>
      <div class="spacer"></div>
      <nav class="links">
        <a href={`${base}#sources`}>Sources</a>
        <a href={`${base}#how`}>How it works</a>
      </nav>
      {roomCode && <span class="room-chip">ROOM&nbsp;{roomCode}</span>}
    </header>
    <slot />
    <script is:inline>
      const nav = document.getElementById('top-nav');
      const onScroll = () => nav && nav.classList.toggle('solid', window.scrollY > 24);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
    <script is:inline define:vars={{ swUrl: `${assetBase}sw.js` }}>
      // Register the (network-only) service worker so the site is
      // installable as a PWA. Registration failing — old browser, blocked
      // scope — must never affect the site itself, hence the empty catch.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(swUrl).catch(() => {});
        });
      }
    </script>
  </body>
</html>
